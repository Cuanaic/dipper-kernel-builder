diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index 7c38247..a6f725b 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -59,7 +59,6 @@ static bool fake_status_initialize_key __read_mostly = false;
 #endif
 
 __maybe_static struct page *fake_status = NULL;
-__maybe_static struct page *real_status_page = NULL; /* live real page pass-through */
 static struct mutex *ksu_selinux_status_lock = NULL;
 static bool selinux_hide_live_logged = false;
 __maybe_static void initialize_fake_status();
@@ -457,13 +456,13 @@ static int my_sel_open_handle_status(struct inode *inode, struct file *filp)
     if (likely(ksu_get_uid_t(current_uid()) >= 10000 && ksu_selinux_hide_enabled)) {
         void *data;
         mutex_lock(ksu_selinux_status_lock);
