+/* ---------------------------------------------------------------------------
+ * ksu selinux_hide: stock-consistency filter for app-facing SELinux oracles.
+ *
+ * The ROM sepolicy ships KernelSU helper types (su, su_exec, su_key,
+ * su_userfaultfd, adbroot*).  A stock policy never defines them, so any
+ * app-visible oracle answer (context validation, access vector, setprocattr)
+ * must behave as if those types did not exist: parse failure / -EINVAL.
+ * Applies only to uid >= 10000 callers, consistent with the other hooks.
+ * ------------------------------------------------------------------------- */
+static bool ksu_ctx_has_hidden_type(const char *s, size_t len)
+{
+    size_t i, field = 0, ts = 0, te = 0, tl;
+
+    if (!s || len < 5)
+        return false;
+
+    for (i = 0; i < len; i++) {
+        if (s[i] == ':') {
+            field++;
+            if (field == 2) {
+                ts = i + 1;
+            } else if (field == 3) {
+                te = i;
+                break;
+            }
+        }
+    }
+    if (field < 2)
+        return false;
+    if (te == 0)
+        te = len; /* type is the last component */
+    if (te <= ts)
+        return false;
+
+    tl = te - ts;
+    while (tl > 0 && (s[ts + tl - 1] == '\0' || s[ts + tl - 1] == '\n' || s[ts + tl - 1] == ' '))
+        tl--;
+    if (tl == 0)
+        return false;
+
+    if (tl == 2 && s[ts] == 's' && s[ts + 1] == 'u')
+        return true; /* su */
+    if (tl >= 3 && !memcmp(s + ts, "su_", 3))
+        return true; /* su_exec, su_key, su_userfaultfd, ... */
+    if (tl >= 7 && !memcmp(s + ts, "adbroot", 7))
+        return true; /* adbroot, adbroot_exec, adbroot_service, ... */
+    if (tl >= 3 && !memcmp(s + ts, "ksu", 3))
+        return true; /* ksu, ksu_file (runtime-added, belt and braces) */
+    return false;
+}
