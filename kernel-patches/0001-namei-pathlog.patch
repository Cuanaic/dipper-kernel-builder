+/* --- KSU debug: catalog path-based syscalls from scanner uids --- */
+static void ksu_dbg_log_path(const char *p)
+{
+	static const char *const toks[] = {
+		"su",     "ksu",    "magisk", "adb",    "module", "mount",
+		"selinux", "kallsyms", "overlay", "frida", "xposed", "zygisk",
+		"droidspace", "tricky", "shamiko", "attr", "trace", "debug",
+	};
+	unsigned int uid = current_uid().val;
+	int i;
+
+	if (!(uid == 10208 || (uid >= 99000 && uid < 100000)))
+		return;
+	if (strstr(p, "/apex/"))
+		return;
+	for (i = 0; i < ARRAY_SIZE(toks); i++) {
+		if (strstr(p, toks[i])) {
+			pr_info("KSUP %d %u %s\n", current->pid, uid, p);
+			return;
+		}
+	}
+}
